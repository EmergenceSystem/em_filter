{application, em_filter, [
    {description, "Library simplifies the creation of filters."},
    {vsn, "0.6.0"},
    {registered, []},
    {applications, [
        kernel,
        stdlib,
        inets,
        wade,
        jsone,
        embryo
    ]},
    {env, []},
    {modules, [em_filter, em_filter_sup, em_filter_server]},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/EmergenceSystem/em_filter"}]}
]}.
