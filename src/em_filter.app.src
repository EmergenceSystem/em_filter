{application, em_filter, [
    {description, "Library simplifies the creation of filters."},
    {vsn, "0.9.0"},
    {registered, [em_filter_sup]},
    {mod, {em_filter_app, []}},
    {applications, [
        kernel,
        stdlib,
        gun,
        embryo
    ]},
    {env, []},
    {modules, [
        em_filter_app,
        em_filter,
        em_filter_sup,
        em_filter_server
    ]},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/EmergenceSystem/em_filter"}]}
]}.
