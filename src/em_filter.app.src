{application, em_filter, [
    {description, "Agent connectivity for Emergence system."},
    {vsn, "1.3.10"},
    {registered, [em_filter_sup, em_pop_sup]},
    {mod, {em_filter_app, []}},
    {applications, [
        kernel,
        stdlib,
        inets,
        gun,
        cowboy,
        kvex
    ]},
    {env, []},
    {modules, [
        em_filter_app,
        em_filter,
        em_filter_sup,
        em_filter_server,
        em_filter_http,
        em_filter_vec,
        em_pop_sup,
        em_pop_node,
        em_pop_http,
        em_pop_store
    ]},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/EmergenceSystem/em_filter"}]}
]}.
